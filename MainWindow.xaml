<Window x:Class="EasyLingo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyLingo"
        xmlns:views="clr-namespace:EasyLingo.Views"
        mc:Ignorable="d"
        Title="EasyLingo" Height="768" Width="1366">
    <Grid>
        <!-- Ekran startowy (Welcome / Log / SignIn) -->
        <ContentControl x:Name="StartContentControl"/>

        <!-- Główny layout po zalogowaniu -->
        <Grid x:Name="MainAppGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="*"/>
                <!-- Reszta okna -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- TopBar -->
                <RowDefinition Height="*"/>
                <!-- Główny content -->
            </Grid.RowDefinitions>

            <!-- Sidebar i TopBar -->
            <views:SidebarView x:Name="Sidebar" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"/>
            <views:TopBarView x:Name="TopBar" Grid.Row="0" Grid.Column="1"/>

            <!-- Zmienny widok (Dashboard, Zestawy, Osiągnięcia) -->
            <ContentControl x:Name="MainContentControl" Grid.Row="1" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
