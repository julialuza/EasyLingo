<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta kolorów (fioletowy/dark modern) -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6A00F4" Offset="0"/>
        <GradientStop Color="#9B4DFF" Offset="0.5"/>
        <GradientStop Color="#FF63C3" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BackgroundDark" Color="#0F1020"/>
    <SolidColorBrush x:Key="SurfaceDark" Color="#12121A"/>
    <SolidColorBrush x:Key="MutedLight" Color="#A6B0C3"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>

    <!-- Card style -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource SurfaceDark}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button style (pill) -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox style -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#141423"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#2A2A3A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <!-- Label style -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
    </Style>

</ResourceDictionary>
