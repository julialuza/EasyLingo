<Window x:Class="EasyLingo.Views.AddSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj zestaw"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Height="550"
        Width="540"
        Background="#FF030912">

    <Grid Margin="18">
        <Border Background="#FF132735" CornerRadius="18" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Text="Dodaj nowy zestaw"
                           Foreground="#FFA8E5FC"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <!-- Name -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Nazwa"
                               Foreground="#FFA8E5FC"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Background="#FF0D1E29"
                             Foreground="White"
                             BorderBrush="#FF1F3B4F"
                             BorderThickness="1"
                             Height="40"
                             Padding="10"
                             FontFamily="Bahnschrift"/>
                </StackPanel>

                <!-- Description -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Opis"
                               Foreground="#FFA8E5FC"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Background="#FF0D1E29"
                             Foreground="White"
                             BorderBrush="#FF1F3B4F"
                             BorderThickness="1"
                             Height="90"
                             Padding="10"
                             FontFamily="Bahnschrift"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </StackPanel>

                <!-- Category -->
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="Kategoria"
                       Foreground="#FFA8E5FC"
                       Margin="0,0,0,6"/>

                    <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                     Background="#FF0D1E29"
                     Foreground="White"
                     BorderBrush="#FF1F3B4F"
                     BorderThickness="1"
                     Height="40"
                     Padding="10"
                     FontFamily="Bahnschrift"/>
                </StackPanel>


                <!-- Error -->
                <TextBlock Grid.Row="4"
                           Text="{Binding ErrorText}"
                           Foreground="#FFB06A78"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>

                <!-- Footer buttons -->
                <Border Grid.Row="5"
                    Background="#FF0D1E29"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,16,0,0">

                                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                                    <Button Content="ANULUJ"
                                    Width="210"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    Background="#FF132735"
                                    Foreground="White"
                                    BorderBrush="#FF1F3B4F"
                                    BorderThickness="1"
                                    FontFamily="Bahnschrift"
                                    Command="{Binding CancelCommand}"/>

                        <Button x:Name="dodajBtn"
                                Content="DODAJ"
                                Width="210"
                                Height="36"
                                Background="#FF0E2432"
                                Foreground="#FFA8E5FC"
                                BorderBrush="#FFA8E5FC"
                                BorderThickness="1.2"
                                FontFamily="Bahnschrift"
                                Command="{Binding SaveCommand}"/>

                    </StackPanel>
                </Border>


            </Grid>
        </Border>
    </Grid>
</Window>
