<UserControl x:Class="EasyLingo.Views.FlashcardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:EasyLingo.Views"
             xmlns:conv="clr-namespace:EasyLingo.Infrastructure.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF030912"/>
            <GradientStop Color="#FF132735" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="← WRÓĆ"
                    Command="{Binding BackCommand}"
                    Width="110" Height="35"
                    Background="#FF0D1E29"
                    Foreground="#FFA8E5FC"
                    BorderBrush="{x:Null}"
                    FontFamily="Bahnschrift"
                    Margin="0,0,16,0"/>

            <TextBlock Grid.Column="1"
                       Text="Flashcards"
                       Foreground="#FFA8E5FC"
                       FontSize="26"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Counters -->
        <Border Grid.Row="1"
                Background="#FF0D1E29"
                CornerRadius="16"
                Padding="12"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding CountersText}"
                       Foreground="White"
                       Opacity="0.9"
                       FontSize="14"/>
        </Border>

        <!-- Card -->
        <Border Grid.Row="2" Background="#FF0D1E29" CornerRadius="20" Padding="24">
            <Grid>
                <!-- FRONT -->
                <TextBlock Text="{Binding FrontText}"
                           FontSize="48"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsFlipped, Converter={StaticResource InvBoolToVis}}"/>

                <!-- BACK -->
                <TextBlock Text="{Binding BackText}"
                           FontSize="42"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsFlipped, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="White" Opacity="0.9" Margin="0,0,0,10"/>

            <!-- Normal buttons (podczas rundy) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Visibility="{Binding IsRoundFinished, Converter={StaticResource InvBoolToVis}}">
                <Button Content="{Binding FlipButtonText}"
                        Command="{Binding FlipCommand}"
                        Width="190" Height="40" Margin="0,0,12,0"
                        Background="#FF132735" Foreground="White" BorderBrush="{x:Null}"
                        FontFamily="Bahnschrift"/>

                <Button Content="NIE ZNAM"
                        Command="{Binding DontKnowCommand}"
                        Width="140" Height="40" Margin="0,0,12,0"
                        Background="#FF132735" Foreground="White" BorderBrush="{x:Null}"
                        FontFamily="Bahnschrift"/>

                <Button Content="ZNAM"
                        Command="{Binding KnowCommand}"
                        Width="110" Height="40"
                        Background="#FF0D1E29" Foreground="#FFA8E5FC" BorderBrush="{x:Null}"
                        FontFamily="Bahnschrift"/>
            </StackPanel>

            <!-- End of round buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Visibility="{Binding IsRoundFinished, Converter={StaticResource BoolToVis}}">
                <Button Content="POWTÓRZ NIEZNANE"
                        Command="{Binding RepeatUnknownCommand}"
                        Width="190" Height="40" Margin="0,0,12,0"
                        Background="#FF132735" Foreground="White" BorderBrush="{x:Null}"
                        FontFamily="Bahnschrift"/>

                <Button Content="POWTÓRZ WSZYSTKO (RESET)"
                        Command="{Binding RepeatAllCommand}"
                        Width="240" Height="40"
                        Background="#FF0D1E29" Foreground="#FFA8E5FC" BorderBrush="{x:Null}"
                        FontFamily="Bahnschrift"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
