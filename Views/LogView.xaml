<UserControl x:Class="EasyLingo.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FF030912"
             MinWidth="1366"
             MinHeight="763">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Border BorderBrush="Black"
                BorderThickness="1"
                Width="600"
                Height="660"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF030912" Offset="0.066"/>
                    <GradientStop Color="#66296988" Offset="1"/>
                    <GradientStop Color="#DF0A1C2A" Offset="0.38"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <TextBlock TextWrapping="Wrap"
                           FontSize="60"
                           FontWeight="Bold"
                           Padding="0,0,0,0"
                           Width="302"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Height="110"
                           Grid.RowSpan="2"
                           Margin="0,91,0,0">
                    <Run Text="Easy" Foreground="White"/>
                    <Run Text="Lingo" Foreground="#00FEF7"/>
                </TextBlock>

                <TextBlock Text="Logowanie"
                           Grid.Row="1"
                           FontSize="28"
                           Width="370"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Grid.RowSpan="2"
                           Foreground="White" Margin="0,89,0,0"/>

                <TextBox Text="{Binding Username, Mode=TwoWay}"
                         Template="{DynamicResource RoundedTextBox}"
                         HorizontalAlignment="Center"
                         Grid.Row="2"
                         VerticalAlignment="Top"
                         Width="370"
                         Height="60"
                         FontSize="20"
                         VerticalContentAlignment="Center"
                         Padding="20,8,8,8"
                         Background="White"
                         BorderBrush="White"
                         Foreground="#FF02ACCC"
                         Margin="0,68,0,0"
                         Grid.RowSpan="2"/>

                <Grid Grid.Row="3" Grid.RowSpan="2" Margin="0,10,0,99">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Left" Width="370" Height="60" Margin="114,50,0,0">
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{DynamicResource RoundedPasswordBox}"
                                     FontSize="20"
                                     Height="60"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <TextBox x:Name="PasswordVisibleBox"
                                 Template="{DynamicResource RoundedTextBox}"
                                 FontSize="20"
                                 Height="60"
                                 VerticalContentAlignment="Center"
                                 Padding="20,8,8,8"
                                 Background="White"
                                 BorderBrush="White"
                                 Foreground="#FF02ACCC"
                                 Visibility="Collapsed"
                                 TextChanged="PasswordVisibleBox_TextChanged"/>

                        <TextBlock x:Name="PasswordPlaceholder"
                                   Foreground="#FF02ACCC"
                                   IsHitTestVisible="False"
                                   FontSize="20"
                                   Padding="20,8,8,8"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ToggleButton x:Name="ShowPasswordToggle"
                                  HorizontalAlignment="Left"
                                  Margin="489,64,0,0"
                                  VerticalAlignment="Top"
                                  Height="32"
                                  Width="33"
                                  BorderBrush="#FF112C3D"
                                  Background="#FF112C3D"
                                  Checked="ShowPasswordToggle_Checked"
                                  Unchecked="ShowPasswordToggle_Unchecked">
                        <TextBlock Text="&#xE7B3;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="25"
                                   Height="23"
                                   Foreground="#FFA1C6CC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ToggleButton>
                </Grid>

                <TextBlock Text="Nazwa użytkownika"
                           FontSize="14"
                           Margin="0,41,330,49"
                           Grid.Row="2"
                           HorizontalAlignment="Right"
                           Width="150"
                           Cursor="Hand"
                           Foreground="#FF02ACCC"/>

                <StackPanel Grid.Row="4" Grid.RowSpan="2"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,40">
                    <Button Style="{DynamicResource RoundedButton}"
                            Content="Zaloguj się"
                            Background="#FF00697D"
                            Width="370"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12"
                            FontSize="20"
                            BorderBrush="#FF00697D"
                            Height="61"
                            Click="LoginButton_Click"/>

                    <Button Style="{DynamicResource RoundedButton}"
                            Content="Załóż konto"
                            Background="#FF133143"
                            Width="370"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            BorderBrush="#FF133143"
                            Height="54"
                            Click="RegisterButton_Click"/>
                </StackPanel>
                <TextBlock Text="Hasło"
                    FontSize="14"
                    Margin="0,35,330,55"
                    Grid.Row="3"
                    HorizontalAlignment="Right"
                    Width="150"
                    Cursor="Hand"
                    Foreground="#FF02ACCC"/>

            </Grid>
        </Border>
    </Grid>
</UserControl>
