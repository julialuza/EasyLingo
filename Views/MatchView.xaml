<UserControl x:Class="EasyLingo.Views.MatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF030912"/>
            <GradientStop Color="#FF132735" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="← WRÓĆ"
                    Command="{Binding BackCommand}"
                    Width="110"
                    Height="35"
                    Background="#FF0D1E29"
                    Foreground="#FFA8E5FC"
                    FontFamily="Bahnschrift"
                    BorderBrush="{x:Null}"
                    Margin="0,0,16,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Łączenie w pary"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#FFA8E5FC"/>
                <TextBlock Text="Kliknij słówko po lewej i tłumaczenie po prawej."
                           Foreground="White"
                           Opacity="0.85"
                           FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding MatchedText}"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"/>
                <Button Content="NOWA RUNDA"
                        Command="{Binding NewRoundCommand}"
                        Width="140"
                        Height="34"
                        Background="#FF0D1E29"
                        Foreground="#FFA8E5FC"
                        BorderBrush="{x:Null}"
                        FontFamily="Bahnschrift"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- MAIN -->
        <Border Grid.Row="1"
                Background="#FF132735"
                CornerRadius="20"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FEEDBACK -->
                <Border Grid.Row="0"
                        Background="#FF0D1E29"
                        CornerRadius="16"
                        Padding="12"
                        Margin="0,0,0,14">
                    <TextBlock Text="{Binding Feedback}"
                               Foreground="White"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- LISTS -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <Border Grid.Column="0"
                            Background="#FF0D1E29"
                            CornerRadius="16"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Słówka"
                                       Foreground="#FFA8E5FC"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <ListBox ItemsSource="{Binding LeftItems}"
                                     SelectedItem="{Binding SelectedLeft}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="B"
                                                            Background="#FF132735"
                                                            CornerRadius="12"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="#FF1B3A4F"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                            <Setter TargetName="B" Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontSize="15"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT -->
                    <Border Grid.Column="2"
                            Background="#FF0D1E29"
                            CornerRadius="16"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Tłumaczenia"
                                       Foreground="#FFA8E5FC"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <ListBox ItemsSource="{Binding RightItems}"
                                     SelectedItem="{Binding SelectedRight}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="B"
                                                            Background="#FF132735"
                                                            CornerRadius="12"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="#FF1B3A4F"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                            <Setter TargetName="B" Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
