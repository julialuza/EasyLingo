<UserControl x:Class="EasyLingo.Views.SetDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF030912"/>
            <GradientStop Color="#FF132735" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="← WRÓĆ"
                    Command="{Binding BackCommand}"
                    Width="110"
                    Height="35"
                    Background="#FF0D1E29"
                    Foreground="#FFA8E5FC"
                    FontFamily="Bahnschrift"
                    BorderBrush="{x:Null}"
                    Margin="0,0,16,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SetName}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#FFA8E5FC"/>
                <TextBlock Text="{Binding SetDescription}"
                           Foreground="White"
                           Opacity="0.85"
                           FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"/>
                <ProgressBar Value="{Binding ProgressPercent}"
                             Maximum="100"
                             Width="220"
                             Height="10"
                             Background="#FF132735"
                             Foreground="#FFA8E5FB"/>
            </StackPanel>
        </Grid>

        <!-- Main -->
        <Border Grid.Row="1"
                Background="#FF132735"
                CornerRadius="20"
                Padding="20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Add form -->
                    <Border Background="#FF0D1E29" CornerRadius="16" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewTermName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0"
                                     Background="#FF132735"
                                     Foreground="White"
                                     BorderBrush="{x:Null}"
                                     Height="36"
                                     Padding="10"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Bahnschrift"
                                     ToolTip="Słówko (np. Dog)"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding NewDefinition, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0"
                                     Background="#FF132735"
                                     Foreground="White"
                                     BorderBrush="{x:Null}"
                                     Height="36"
                                     Padding="10"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Bahnschrift"
                                     ToolTip="Tłumaczenie (np. Pies)"/>

                            <Button Grid.Column="2"
                                    Content="DODAJ"
                                    Width="90"
                                    Height="36"
                                    Background="#FF0D1E29"
                                    Foreground="#FFA8E5FC"
                                    BorderBrush="{x:Null}"
                                    FontFamily="Bahnschrift"
                                    Command="{Binding AddTermCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Terms list -->
                    <Border Grid.Row="1" Background="#FF0D1E29" CornerRadius="16" Padding="10">
                        <ListView ItemsSource="{Binding Terms}"
                                  SelectedItem="{Binding SelectedTerm}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="White">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="#FF132735"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding TermName}" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Definition}" Opacity="0.9" VerticalAlignment="Center"/>

                                        <Button Grid.Column="2"
                                                Content="USUŃ"
                                                Width="70"
                                                Height="28"
                                                Margin="10,0,0,0"
                                                Background="#FF0D1E29"
                                                Foreground="#FFA8E5FC"
                                                BorderBrush="{x:Null}"
                                                FontFamily="Bahnschrift"
                                                Command="{Binding DataContext.DeleteTermCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Border Grid.Row="2" Background="#FF0D1E29" CornerRadius="16" Padding="14" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Edycja zaznaczonego słówka"
                                       Foreground="#FFA8E5FC"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding EditTermName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0"
                                         Background="#FF132735"
                                         Foreground="White"
                                         BorderBrush="{x:Null}"
                                         Height="36"
                                         Padding="10"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Bahnschrift"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding EditDefinition, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#FF132735"
                                         Foreground="White"
                                         BorderBrush="{x:Null}"
                                         Height="36"
                                         Padding="10"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Bahnschrift"/>
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="WYCZYŚĆ"
                                        Width="90"
                                        Height="34"
                                        Margin="0,0,10,0"
                                        Background="#FF132735"
                                        Foreground="White"
                                        BorderBrush="{x:Null}"
                                        FontFamily="Bahnschrift"
                                        Command="{Binding ClearEditCommand}"/>

                                <Button Content="ZAPISZ"
                                        Width="90"
                                        Height="34"
                                        Background="#FF0D1E29"
                                        Foreground="#FFA8E5FC"
                                        BorderBrush="{x:Null}"
                                        FontFamily="Bahnschrift"
                                        Command="{Binding SaveEditCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1"/>

                <Border Grid.Column="2" Background="#FF0D1E29" CornerRadius="16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Tryby powtórek"
                                   Foreground="#FFA8E5FC"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <Button Content="FLASHCARDS"
                                Height="44"
                                Margin="0,0,0,10"
                                Background="#FF132735"
                                Foreground="White"
                                BorderBrush="{x:Null}"
                                FontFamily="Bahnschrift"
                                Command="{Binding OpenFlashcardsCommand}"/>

                        <Button Content="QUIZ ABC"
                                Height="44"
                                Margin="0,0,0,10"
                                Background="#FF132735"
                                Foreground="White"
                                BorderBrush="{x:Null}"
                                FontFamily="Bahnschrift"
                                Command="{Binding OpenMultipleChoiceCommand}"/>

                        <Button Content="MATCH (PARY)"
                                Height="44"
                                Margin="0,0,0,10"
                                Background="#FF132735"
                                Foreground="White"
                                BorderBrush="{x:Null}"
                                FontFamily="Bahnschrift"
                                Command="{Binding OpenMatchCommand}"/>

                        <Button Content="WPISYWANIE"
                                Height="44"
                                Background="#FF132735"
                                Foreground="White"
                                BorderBrush="{x:Null}"
                                FontFamily="Bahnschrift"
                                Command="{Binding OpenTypingCommand}"/>

                        <Button Content="RESET POSTĘPU"
                                Height="34"
                                Margin="0,100,0,0"
                                Background="#FF0D1E29"
                                Foreground="#FFA8E5FC"
                                BorderBrush="{x:Null}"
                                FontFamily="Bahnschrift"
                                Command="{Binding ReloadCommand}"/>
                        <Button Content="EDYTUJ ZESTAW"
                            Height="34"
                            Margin="0,10,0,0"
                            Background="#FF0D1E29"
                            Foreground="#FFA8E5FC"
                            BorderBrush="{x:Null}"
                            FontFamily="Bahnschrift"
                            Command="{Binding EditSetCommand}"/>

                        <Button Content="USUŃ ZESTAW"
                            Height="34"
                            Margin="0,10,0,0"
                            Background="#FF0D1E29"
                            Foreground="#FFA8E5FC"
                            BorderBrush="{x:Null}"
                            FontFamily="Bahnschrift"
                            Command="{Binding DeleteSetCommand}"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
