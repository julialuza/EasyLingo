<UserControl x:Class="EasyLingo.Views.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FF030912"
             MinWidth="1366"
             MinHeight="763">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Border BorderBrush="Black"
                BorderThickness="1"
                Width="600"
                Height="660"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF030912" Offset="0.066"/>
                    <GradientStop Color="#66296988" Offset="1"/>
                    <GradientStop Color="#DF0A1C2A" Offset="0.38"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110*"/>
                    <RowDefinition Height="110*"/>
                    <RowDefinition Height="110*"/>
                    <RowDefinition Height="110*"/>
                    <RowDefinition Height="106*"/>
                    <RowDefinition Height="113*"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <TextBlock TextWrapping="Wrap"
                           FontSize="60"
                           FontWeight="Bold"
                           Width="302"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Height="110"
                           Grid.RowSpan="2"
                           Margin="0,91,0,0">
                    <Run Text="Easy" Foreground="White"/>
                    <Run Text="Lingo" Foreground="#00FEF7"/>
                </TextBlock>

                <TextBlock Text="Rejestracja"
                           Grid.Row="1"
                           FontSize="28"
                           Width="370"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Grid.RowSpan="2"
                           Foreground="White"
                           Margin="0,79,0,0" Height="37"/>

                <!-- Username -->
                <TextBox Text="{Binding Username, Mode=TwoWay}"
                         Template="{DynamicResource RoundedTextBox}"
                         HorizontalAlignment="Center"
                         Grid.Row="2"
                         VerticalAlignment="Top"
                         Width="370"
                         Height="60"
                         FontSize="20"
                         VerticalContentAlignment="Center"
                         Padding="20,8,8,8"
                         Background="White"
                         BorderBrush="White"
                         Foreground="#FF02ACCC"
                         Margin="0,40,0,0"/>

                <TextBlock Text="Nazwa użytkownika"
                           FontSize="14"
                           Margin="0,15,330,0"
                           Grid.Row="2"
                           HorizontalAlignment="Right"
                           Width="150"
                           Foreground="#FF02ACCC"/>

                <!-- Password -->
                <Grid Grid.Row="2" Margin="0,100,0,10" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Left" Width="370" Height="60" Margin="114,10,0,0">
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{DynamicResource RoundedPasswordBox}"
                                     FontSize="20"
                                     Height="60"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <TextBox x:Name="PasswordVisibleBox"
                                 Template="{DynamicResource RoundedTextBox}"
                                 FontSize="20"
                                 Height="60"
                                 VerticalContentAlignment="Center"
                                 Padding="20,8,8,8"
                                 Background="White"
                                 BorderBrush="White"
                                 Foreground="#FF02ACCC"
                                 Visibility="Collapsed"
                                 TextChanged="PasswordVisibleBox_TextChanged"/>

                        <TextBlock x:Name="PasswordPlaceholder"
                                   Text=""
                                   Foreground="#FF02ACCC"
                                   IsHitTestVisible="False"
                                   FontSize="20"
                                   Padding="20,8,8,8"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ToggleButton x:Name="ShowPasswordToggle"
                                  HorizontalAlignment="Left"
                                  Margin="489,44,0,0"
                                  VerticalAlignment="Top"
                                  Height="32"
                                  Width="33"
                                  BorderBrush="#FF112C3D"
                                  Background="#FF112C3D"
                                  Checked="ShowPasswordToggle_Checked"
                                  Unchecked="ShowPasswordToggle_Unchecked">
                        <TextBlock Text="&#xE7B3;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="25"
                                   Height="23"
                                   Foreground="#FFA1C6CC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ToggleButton>
                </Grid>

                <!-- Confirm Password -->
                <Grid Grid.Row="3" Margin="0,82,0,28" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Left" Width="370" Height="60" Margin="114,10,0,0">
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{DynamicResource RoundedPasswordBox}"
                                     FontSize="20"
                                     Height="60"
                                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                        <TextBox x:Name="ConfirmPasswordVisibleBox"
                                 Template="{DynamicResource RoundedTextBox}"
                                 FontSize="20"
                                 Height="60"
                                 VerticalContentAlignment="Center"
                                 Padding="20,8,8,8"
                                 Background="White"
                                 BorderBrush="White"
                                 Foreground="#FF02ACCC"
                                 Visibility="Collapsed"
                                 TextChanged="ConfirmPasswordVisibleBox_TextChanged"/>

                        <TextBlock x:Name="ConfirmPasswordPlaceholder"
                                   Text=""
                                   Foreground="#FF02ACCC"
                                   IsHitTestVisible="False"
                                   FontSize="20"
                                   Padding="20,8,8,8"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ToggleButton x:Name="ShowConfirmPasswordToggle"
                                  HorizontalAlignment="Left"
                                  Margin="489,44,0,0"
                                  VerticalAlignment="Top"
                                  Height="32"
                                  Width="33"
                                  BorderBrush="#FF112C3D"
                                  Background="#FF112C3D"
                                  Checked="ShowConfirmPasswordToggle_Checked"
                                  Unchecked="ShowConfirmPasswordToggle_Unchecked">
                        <TextBlock Text="&#xE7B3;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="25"
                                   Height="23"
                                   Foreground="#FFA1C6CC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ToggleButton>
                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="4"
                            VerticalAlignment="Top"
                            Margin="0,64,0,0" Height="115" Grid.RowSpan="2">
                    <Button Style="{DynamicResource RoundedButton}"
                            Content="Zarejestruj się"
                            Background="#FF00697D"
                            Width="370"
                            FontSize="20"
                            BorderBrush="#FF00697D"
                            Height="61"
                            Click="RegisterButton_Click" Margin="0,20,0,0"/>
                    <Button Style="{DynamicResource RoundedButton}"
                            Content="Masz już konto? Zaloguj"
                            Background="#FF133143"
                            Width="370"
                            FontSize="18"
                            BorderBrush="#FF133143"
                            Height="33"
                            Click="BackToLoginButton_Click"/>
                </StackPanel>

            </Grid>
        </Border>
        <TextBlock
            FontSize="14"
            Margin="0,382,715,286"
            HorizontalAlignment="Right"
            Width="150"
            Foreground="#FF02ACCC"><Run Language="pl-pl" Text="Hasło"/></TextBlock>
        <TextBlock
            FontSize="14"
            Margin="0,471,715,197"
            HorizontalAlignment="Right"
            Width="150"
            Foreground="#FF02ACCC"><Run Language="pl-pl" Text="Powtórz h"/><Run Text="asło"/></TextBlock>
    </Grid>
</UserControl>
