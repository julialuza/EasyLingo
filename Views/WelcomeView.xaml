<UserControl x:Class="EasyLingo.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" MinWidth="1366" MinHeight="763" Background="#FF030912">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image HorizontalAlignment="Left" VerticalAlignment="Top" Source="/Resources/world_img.png" Margin="603,30,0,0" Stretch="Fill" Width="738" Grid.ColumnSpan="2" Height="707"/>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="200,0,0,0" Width="473">
            <TextBlock TextWrapping="Wrap" FontSize="60" FontWeight="Bold" Padding="0,0,0,12" Margin="0,0,0,20" Width="401" Height="90" HorizontalAlignment="Left"><Run Language="pl-pl" Text="Easy" Foreground="White"/><Run Language="pl-pl" Text="Lingo" Foreground="#00FEF7                                                                                                                                                                                                                               "/><LineBreak/><Run Language="pl-pl"/></TextBlock>
            <TextBlock TextWrapping="Wrap" Text="Ucz się języków w prosty i przyjemny sposób. Twórz zestawy słówek i sprawdzaj swoje postępy." FontSize="20" Width="447" Margin="0,0,0,40" Foreground="#FFE8ECED" HorizontalAlignment="Left"/>
            <Button x:Name="SignInButton" Style="{DynamicResource RoundedButton}" Content="Zarejestruj się" Background="#FF00697D" Width="300" Height="49" HorizontalAlignment="Left" Margin="0,0,0,12" FontSize="20" BorderBrush="#FF00697D" Click="SignInButton_Click"/>
            <Button x:Name="LoginButton" Style="{DynamicResource RoundedButton}" Content="Zaloguj się" Background="#FF030912" Width="300" Height="49" FontSize="20" HorizontalAlignment="Left" BorderBrush="#FF030912" Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
